APP_NAME=Laravel
APP_ENV=local  # bu hal olanda bazanin migrasiyasi avtomatik olur
#APP_ENV=production  # Bu halda artiq manual icra edilmeli olacaq
# The key of the application is generated with "php artisan key:generate"
# and is not part of the repository. A key that is part of the
# repository is a key that everybody has.
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE='Asia/Baku'
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=tasks_project
DB_USERNAME=AzeriCard
# The password of the local machine. The value that was in the
# repository before is in the history of the repository, so it is
# compromised and has to be changed.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The secret of the token is generated with "openssl rand -base64 48" and
# is not part of the repository.
JWT_SECRET=
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=false
JWT_TTL=60


L5_SWAGGER_CONST_HOST=http://localhost