# Copy this file to var/.env and fill in the values for your machine.
# var/.env is ignored by git. Never commit a real credential.
#
# The same values can be supplied through the environment of the process that
# starts the compose stack. The environment wins over the file.
#
# The values of the application that are not here — the key of the application
# and the secret of the token — are generated with:
#
#   docker compose run --rm artisan key:generate --show
#   openssl rand -base64 48

# The database of the compose stack.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=tasks_project
DB_USERNAME=AzeriCard
# A password of the local machine. The value that was in the repository
# before is in the history of the repository, so it is compromised and has to
# be changed. The placeholder below is the password of the local stack and
# nothing else.
DB_PASSWORD=change-me

# The port of the database on the machine.
MONGO_PORT=37017

# The port the application is reachable at.
APP_PORT=8000

# The address the documentation of the API is written with.
L5_SWAGGER_CONST_HOST=http://localhost/api/v1
